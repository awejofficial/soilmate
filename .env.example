# SoilMate Environment Configuration Example
# Copy this file to .env for local testing or configure these in Streamlit Community Cloud Secrets.
# NEVER commit real API keys or secrets to source control.

APP_ENV=production
AI_PROVIDER=huggingface
AI_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Hugging Face User Access Token (Free tier serverless inference)
# Leave blank to run SoilMate in 100% deterministic, offline-ready fallback mode at ₹0 cost.
HF_TOKEN=

# Request timeout in seconds for AI calls
REQUEST_TIMEOUT_SECONDS=30

# Optional Supabase credentials (if cloud multi-device sync is enabled)
# SUPABASE_URL=
# SUPABASE_KEY=
